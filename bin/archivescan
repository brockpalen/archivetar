#!/usr/bin/python3


# Brock Palen
# brockp@umich.edu
#
# The intent of this is to generate a report for data to be uploaded to Data Den
# https://arc-ts.umich.edu/data-den/
# Data Den only accepts files > 100MB, it enforces this by providing only 10,000 files/TB of prvisoned capacity
#
# Often data in a single folder looks like:
# Files >100MB   100 Files  100GB
# Files <100MB 10000 Files  2GB
#
# Example, migrate and premigrate are both 100MB.  On a streatch cluster size and thus blocks is 2x if 2 copies etc
# size  du      blocks (stat)
# 100M  2048    4096    migrate
# 100M  204800  409600  premigrate
#
# You could combine Locker
# https://arc-ts.umich.edu/locker/
# Which frontends Data Den as a cache to hold smaller files

## TODO
#
# * Generate optional list of files
# * Make seetings setable from envrionment

import argparse
import csv
import fnmatch
import json
import logging
import os
import re
import sys
import time
from multiprocessing import Lock, Pool, Queue

# setup logging
logger = logging.getLogger(__name__)
logger.setLevel(logging.DEBUG)
st_handler = logging.StreamHandler()
logger.addHandler(st_handler)

# This is to get the directory that the program
# is currently running in.
dir_path = os.getcwd()

datadenrate = float(os.getenv("DATADENRATE", 20.04))

# data den Migrate size MB, default for --size
migratesize = int(os.getenv("MIGRATESIZE", 100))

# cost of Locker/TB/yr
lockerrate = float(os.getenv("LOCKERRATE", 54.37))

# Locker file quota/MB
lockerinode = int(os.getenv("LOCKERINODE", 1.0e6))

# minimum size of a file to consider offline based on block size.
# for GPFS this normally means 2
minblocks = float(os.getenv("MINBLOCKS", 2.0))

# Replica factor
# for GPFS / Spectrum Scale streatch systems the blocks on disk will be a multiple of replication.
replicas = int(os.getenv("REPLICAS", 2.0))

# ratio offline. This often needs to be higher than 1 to account for some sparsenes in files such as zip files.
# This tool assumes that your mostly managing data on large offline storage systems such as AWS Glacier, HPSS, and Spectrum Archive.
# Thus the offline ratio if often very large often much greater than 10:1
offlineratio = int(os.getenv("OFFLINERATIO", 2.0))

byteintbyte = 1024.0 * 1024 * 1024 * 1024

# binary unit multipliers for --size, stdlib only so this stays a standalone script
size_units = {"": 1, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4, "P": 1024**5}


def parse_size(text):
    """Parse a human size such as 100M, 1.5G or 2TiB into bytes.

    Units are always binary (1K = 1024 bytes); a trailing "B" or "iB" is
    optional. A bare number is taken as bytes.

    Args:
        text: Size string to parse.

    Returns:
        Size in bytes as an int.

    Raises:
        argparse.ArgumentTypeError: If the text is not a valid size.
    """
    match = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([KMGTP]?)(?:i?B)?\s*", text, re.I)
    if not match:
        raise argparse.ArgumentTypeError(
            f"invalid size '{text}', expected a number with optional unit e.g. 100M, 1G"
        )
    number, unit = match.groups()
    return int(float(number) * size_units[unit.upper()])


parser = argparse.ArgumentParser(
    description="""
Standalone tool for number of archive management functions.
""",
    epilog="Author Brock Palen brockp@umich.edu",
)

default_threads = 8
default_recall = 20

parser.add_argument(
    "-f",
    "--filter",
    help="Include only matching files in statistics and recalls (Python fnmatch syntax).",
    type=str,
    default="*",
)
parser.add_argument(
    "-s",
    "--size",
    help=(
        "Files larger than this are Data Den candidates, e.g. 100M, 1G; binary units. "
        f"Default {migratesize}M (env MIGRATESIZE in MB)"
    ),
    type=parse_size,
    default=migratesize * 1024 * 1024,
)
parser.add_argument(
    "-v",
    "--verbose",
    help="Print additional informaiton while running, multiple -v will increase output",
    action="count",
    default=0,
)
parser.add_argument(
    "-q",
    "--quiet",
    help="Don't print the totals summary at the end",
    action="store_true",
)
parser.add_argument(
    "--format",
    choices=("table", "tsv", "csv", "json"),
    default="table",
    help="output format (default: table)",
)
parser.add_argument("--no-header", action="store_true", help="omit the header row")
parser.add_argument(
    "-d",
    "--max-depth",
    help="One row per directory down to depth N, like du -d; each row counts "
    "everything below it and the last row (.) is the whole tree",
    type=int,
    metavar="N",
)
parser.add_argument(
    "--sort",
    choices=("size", "files", "cache", "offline", "name"),
    default="size",
    help="order of the --max-depth rows: total size, total files, cache files, "
    "fraction offline (each largest first) or name (default: size)",
)
parser.add_argument(
    "-c",
    "--current-state",
    help="Show the current state of files in archive rather than future state",
    action="store_true",
)
parser.add_argument(
    "--print",
    "--print-cached",
    help="Print the names of files on cache",
    action="store_true",
)
parser.add_argument(
    "--print-offline",
    help="Print the names of files currently offline",
    action="store_true",
)
parser.add_argument(
    "-p",
    "--parallel",
    help=f"Number of parallel workers for scan to start default: {default_threads}",
    type=int,
    default=default_threads,
    metavar="N",
)
parser.add_argument(
    "-r",
    "--recall",
    help="Trigger recall of any file that appears offline",
    action="store_true",
)
parser.add_argument(
    "-w",
    "--recall-workers",
    help="Number of recall workers DO NOT use more than 50 default: {default_recall}",
    type=int,
    default=default_recall,
    metavar="N",
)

ops = parser.parse_args()

if ops.max_depth is not None and ops.max_depth < 0:
    parser.error("--max-depth must be 0 or more")

# file names printed by the scan workers share stdout and would corrupt the output
if ops.format != "table" and (ops.quiet or ops.print or ops.print_offline):
    parser.error(
        f"--format {ops.format} cannot be combined with --quiet, --print or --print-offline"
    )

if ops.verbose == 1:
    st_handler.setLevel(logging.INFO)
elif ops.verbose >= 2:
    st_handler.setLevel(logging.DEBUG)
else:
    st_handler.setLevel(logging.WARNING)


recall_queue = Queue()


def get_size(start_path=".", filter_size=104857600):
    """Scan a tree in parallel, one task per directory.

    Args:
        start_path: Directory to walk.
        filter_size: Files larger than this many bytes are Data Den candidates.

    Returns:
        Dict of directory path to that directory's own files, as
        ``(dataden_bytes, dataden_files, cache_bytes, cache_files)``.
    """
    walked = [
        (dirpath, filenames, filter_size)
        for dirpath, dirnames, filenames in os.walk(start_path)
    ]
    with Pool(processes=ops.parallel) as pool:
        output = pool.map(get_size_local, walked)
    return {task[0]: tally for task, tally in zip(walked, output)}


def is_snapshot(dirpath):
    """Whether a directory is inside a locker '.snapshot' directory.

    Args:
        dirpath: Directory path from the walk.

    Returns:
        True if the path should be left out of the scan.
    """
    return re.search(r".snapshot", dirpath) is not None


def rollup(tallies, max_depth):
    """Add each directory's own files into its ancestors, down to max_depth.

    Works like ``du -d``: every directory at or above max_depth gets a total
    of everything below it, and "." is the whole tree.

    Args:
        tallies: Per-directory results from :func:`get_size`.
        max_depth: Deepest level that gets its own total; 0 for only ".".

    Returns:
        Dict of relative path ("." or "./name/...") to
        ``[dataden_bytes, dataden_files, cache_bytes, cache_files]``.
    """
    totals = {".": [0, 0, 0, 0]}
    for dirpath, tally in tallies.items():
        if is_snapshot(dirpath):
            continue
        relative = os.path.relpath(dirpath, ".")
        parts = [] if relative == "." else relative.split(os.sep)
        for depth in range(min(len(parts), max_depth) + 1):
            key = os.path.join(".", *parts[:depth]) if depth else "."
            accumulated = totals.setdefault(key, [0, 0, 0, 0])
            for index, number in enumerate(tally):
                accumulated[index] += number
    return totals


def get_size_local(args):
    dirpath, filenames, filter_size = args
    total_size = 0  # total size to archive / already archived
    total_cnt = 0  # counts for archive
    ctotal_size = 0  # size for cache (to small for archive) / on cache
    ctotal_cnt = 0  # counts for cache (to small for archive)

    # skip if a locker '.snapshot' directory
    if is_snapshot(dirpath):
        return total_size, total_cnt, ctotal_size, ctotal_cnt

    for f in filenames:
        fp = os.path.join(dirpath, f)
        if not fnmatch.fnmatch(fp, ops.filter):
            continue

        # skip if it is symbolic link
        if not os.path.islink(fp) and os.path.isfile(fp):
            st = os.stat(fp)
            blocks = st.st_blocks
            size = st.st_size
            if blocks == 0:  # zero size files
                ratio = 1.0
            elif blocks <= minblocks:
                # files smaller than blocksize * 2 on GPFS will show up as offline
                ratio = replicas * (float(size) / (float(blocks) * 512.0))
                logger.info(
                    f"file: {f} size: {size} blocks: {blocks} is less than minblocks: {minblocks} thus assumed online ratio before adjustmint: {ratio}"
                )
                ratio = 1.0
            else:
                ratio = replicas * (float(size) / (float(blocks) * 512.0))

            logger.debug(
                f"file: {f} size: {size} blocks: {blocks} archive to cache ratio: {ratio:.2f}"
            )
            if ops.current_state:  # are se seeing what would or what did
                metric = ratio
                value = offlineratio
            else:
                metric = size
                value = filter_size

            if metric > value:
                total_size += size
                total_cnt += 1
            if metric <= value:
                ctotal_size += size
                ctotal_cnt += 1

            if ops.print_offline and ratio > 1.0:
                # file is offline
                print(fp)

            if ops.print and ratio <= 1.0:  # file is online/cached
                print(fp)

            if ops.recall and ratio > 1.0:
                logger.debug(f"Adding to recall queue: {fp}")
                recall_queue.put(fp)

    return total_size, total_cnt, ctotal_size, ctotal_cnt


def recall_worker(iolock):
    """Worker that knows how to recall a file from tape."""
    while True:
        fp = recall_queue.get()
        if fp is None:
            break

        logger.debug(f"Attempting to recall: {fp}")
        with open(fp, "rb") as token:
            token.seek(-1, 2)  # seek to end of file minus one byte
            token.read(1)  # read exactly one byte to trigger recall don't save it
        logger.info(
            "Recall time for %s is %.2f Seconds" % (fp, time.time() - start_time)
        )


def recall():
    """Use parallel pool of workers to recall."""
    iolock = Lock()
    logger.debug("Starting Recall")
    p = Pool(ops.recall_workers, initializer=recall_worker, initargs=(iolock,))
    for _ in range(ops.recall_workers):  # tell workers we are done
        recall_queue.put(None)

    p.close()
    p.join()


# binary units humanfriendly.format_size(binary=True) uses, so the report
# matches globus-fs archivescan without needing the package
binary_size_symbols = ("KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB")


def round_number(number):
    """Round to two decimals and drop trailing zeros, like humanfriendly.

    Args:
        number: The value to format.

    Returns:
        Text such as "394.7", "1.33" or "0".
    """
    text = "%.2f" % float(number)
    return re.sub(r"\.$", "", re.sub("0+$", "", text))


def format_size(num_bytes):
    """Format a byte count in binary units the way globus-fs does.

    Args:
        num_bytes: Size in bytes.

    Returns:
        Text such as "100 MiB", "1.3 TiB", "1 byte" or "0 bytes".
    """
    for power in range(len(binary_size_symbols), 0, -1):
        divider = 1024**power
        if num_bytes >= divider:
            return (
                f"{round_number(num_bytes / divider)} {binary_size_symbols[power - 1]}"
            )
    return f"{round_number(num_bytes)} {'byte' if num_bytes == 1 else 'bytes'}"


def human_size(num_bytes):
    """Format a byte count the way GNU ``du -h`` does, for the directory table.

    Same rules as globus-fs du: rounded up so a size is never understated,
    one decimal below 10 (1.5G), whole numbers from there (234M) and plain
    bytes below 1K. Integer arithmetic, so no float rounding.

    Args:
        num_bytes: Size in bytes.

    Returns:
        Text such as "0", "512", "4.0K", "234M" or "1.5G".
    """
    if num_bytes < 1024:
        return str(num_bytes)
    letters = "KMGTPE"
    for power, letter in enumerate(letters, start=1):
        unit = 1024**power
        tenths = -(-num_bytes * 10 // unit)  # ceil to one decimal, times 10
        if tenths < 100:
            return f"{tenths // 10}.{tenths % 10}{letter}"
        whole = -(-num_bytes // unit)
        if whole < 1024 or power == len(letters):
            return f"{whole}{letter}"
    return str(num_bytes)


# terminal control and text direction characters; a file or directory name
# can contain them and a terminal would act on them instead of showing them
unsafe_characters = re.compile(
    "[\x00-\x1f\x7f-\x9f\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]"
)


def safe(text):
    """Escape control characters for a terminal, keep exact text for a pipe.

    Args:
        text: The text to print.

    Returns:
        The text with control characters escaped if stdout is a terminal.
    """
    if not sys.stdout.isatty():
        return text
    named = {"\n": "\\n", "\t": "\\t", "\r": "\\r"}

    def visible(match):
        character = match.group()
        code = ord(character)
        if character in named:
            return named[character]
        return f"\\x{code:02x}" if code < 0x100 else f"\\u{code:04x}"

    return unsafe_characters.sub(visible, text)


def make_row(path, tally, seconds):
    """Build one result row with the keys globus-fs archivescan uses.

    Args:
        path: Absolute path of the directory the row describes.
        tally: ``[dataden_bytes, dataden_files, cache_bytes, cache_files]``.
        seconds: Time the whole scan took.

    Returns:
        Dict of results, in output column order.
    """
    dataden_bytes, dataden_files, cache_bytes, cache_files = tally
    total_bytes = dataden_bytes + cache_bytes
    # no fraction for an empty or fully filtered tree
    fraction = 100.0 * dataden_bytes / total_bytes if total_bytes else None
    return {
        "path": path,
        "threshold_bytes": ops.size,
        "dataden_files": dataden_files,
        "dataden_bytes": dataden_bytes,
        "cache_files": cache_files,
        "cache_bytes": cache_bytes,
        "total_files": dataden_files + cache_files,
        "total_bytes": total_bytes,
        "fraction_offline": None if fraction is None else round(fraction, 5),
        "seconds": seconds,
    }


def print_machine(rows, as_list):
    """Print rows as tsv, csv or json, with exact byte counts and no units.

    Args:
        rows: Result rows from :func:`make_row`.
        as_list: For json, print a list even for one row (--max-depth mode).
    """
    if ops.format == "json":
        json.dump(rows if as_list else rows[0], sys.stdout, indent=2)
        print()
        return
    # one row per directory, so a loop over many trees builds one table
    writer = csv.writer(
        sys.stdout,
        delimiter="\t" if ops.format == "tsv" else ",",
        lineterminator="\n",
    )
    if not ops.no_header:
        writer.writerow([key.upper() for key in rows[0]])
    for row in rows:
        writer.writerow(
            [
                (
                    ""
                    if value is None
                    else safe(value) if isinstance(value, str) else value
                )
                for value in row.values()
            ]
        )


def print_report(row):
    """Print the single-tree summary in the format chosen with --format.

    Keys and layout match ``globus-fs archivescan`` so output from both
    tools can be combined.

    Args:
        row: Scan results from :func:`make_row`.
    """
    if ops.format != "table":
        print_machine([row], as_list=False)
    elif not ops.quiet:
        print_table(row)


def sort_entries(entries):
    """Order --max-depth rows by --sort, keeping the "." total last.

    Args:
        entries: ``(relative path, row)`` pairs.

    Returns:
        The pairs in display order.
    """
    sort_keys = {
        "size": lambda row: -row["total_bytes"],
        "files": lambda row: -row["total_files"],
        "cache": lambda row: -row["cache_files"],
        # directories with no files have no fraction; put them last
        "offline": lambda row: (
            row["fraction_offline"] is None,
            -(row["fraction_offline"] or 0),
        ),
        "name": lambda row: 0,
    }
    sort_key = sort_keys[ops.sort]
    total = [entry for entry in entries if entry[0] == "."]
    others = [entry for entry in entries if entry[0] != "."]
    others.sort(key=lambda entry: (sort_key(entry[1]), entry[0]))
    return others + total


def print_directory_report(entries):
    """Print one row per directory in the format chosen with --format.

    Args:
        entries: ``(relative path, row)`` pairs in display order.
    """
    if ops.format != "table":
        print_machine([row for _, row in entries], as_list=True)
    elif not ops.quiet:
        print_directory_table(entries)


def print_directory_table(entries):
    """Print --max-depth rows as an aligned table for reading by eye.

    Numbers are right-aligned with du -h sizes so magnitudes line up, and
    the path comes last so long names don't break the columns.

    Args:
        entries: ``(relative path, row)`` pairs in display order.
    """
    columns = (
        ("DATADEN_FILES", lambda row: str(row["dataden_files"])),
        ("DATADEN_SIZE", lambda row: human_size(row["dataden_bytes"])),
        ("CACHE_FILES", lambda row: str(row["cache_files"])),
        ("CACHE_SIZE", lambda row: human_size(row["cache_bytes"])),
        ("TOTAL_FILES", lambda row: str(row["total_files"])),
        ("TOTAL_SIZE", lambda row: human_size(row["total_bytes"])),
        (
            "OFFLINE%",
            lambda row: (
                "-"
                if row["fraction_offline"] is None
                else f"{row['fraction_offline']:.2f}"
            ),
        ),
    )
    cells = [[render(row) for _, render in columns] for _, row in entries]
    widths = [
        max([len(header)] + [len(line[index]) for line in cells])
        for index, (header, _) in enumerate(columns)
    ]
    if not ops.no_header:
        headers = [
            header.rjust(widths[index]) for index, (header, _) in enumerate(columns)
        ]
        print("  ".join(headers + ["PATH"]))
    for line, (path, _) in zip(cells, entries):
        padded = [cell.rjust(widths[index]) for index, cell in enumerate(line)]
        print("  ".join(padded + [safe(path)]))


def print_table(row):
    """Print the human-readable report.

    Args:
        row: Scan results, as built in the main program.
    """
    print("----- Results ------")
    print(f"Threshold: files larger than {format_size(row['threshold_bytes'])}")
    print("")
    print("Data Den Candidates:")
    print(f"Files: {row['dataden_files']}")
    print(f"Size: {format_size(row['dataden_bytes'])}")
    print("")
    print("Cache (Locker) Candidates:")
    print(f"Files: {row['cache_files']}")
    print(f"Size: {format_size(row['cache_bytes'])}")
    print("")
    print("Total:")
    print(f"Files: {row['total_files']}")
    print(f"Size: {format_size(row['total_bytes'])}")
    print("")
    print(f"Total Time {row['seconds']:.2f} Seconds")
    if row["fraction_offline"] is None:
        print("Fraction Offline: n/a (no files)")
    else:
        print(f"Fraction Offline: {row['fraction_offline']:.5f} %")


# cache size for transent data to and from tape
# In TB max(1.0, min( 10% tape, 10))
def calc_cache(tapesize):
    return max(1.0, min(0.1 * tapesize, 10))


####  Main Program
if __name__ == "__main__":

    # This is to get the directory that the program
    # is currently running in.
    dir_path = os.getcwd()

    start_time = time.time()

    tallies = get_size(filter_size=ops.size)
    directory_totals = rollup(tallies, ops.max_depth or 0)
    seconds = round(time.time() - start_time, 2)

    entries = [
        (path, make_row(os.path.normpath(os.path.join(dir_path, path)), tally, seconds))
        for path, tally in directory_totals.items()
    ]
    if ops.max_depth is None:
        print_report(dict(entries)["."])
    else:
        print_directory_report(sort_entries(entries))

    if ops.recall:
        recall()
